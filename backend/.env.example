# Allianz API Credentials (from Allianz Developer Portal > Apps)
ALLIANZ_CONSUMER_KEY=
ALLIANZ_CONSUMER_SECRET=

# Allianz API Base URL
# UAT: https://asia-uat-malaysia.apis.allianz.com
# Prod: https://asia-malaysia.apis.allianz.com
ALLIANZ_BASE_URL=https://asia-uat-malaysia.apis.allianz.com

# Partner ID assigned by Allianz (used as sourceSystem / partnerId)
ALLIANZ_PARTNER_ID=

# Server config
PORT=3001

# CORS - comma-separated allowed origins
FRONTEND_URL=http://localhost:3000
