# Allianz API Credentials (from Allianz Developer Portal > Apps)
ALLIANZ_CONSUMER_KEY=your_consumer_key
ALLIANZ_CONSUMER_SECRET=your_consumer_secret

# Allianz API Base URL
# UAT: https://asia-uat-malaysia.apis.allianz.com
# Prod: https://asia-malaysia.apis.allianz.com
ALLIANZ_BASE_URL=https://asia-uat-malaysia.apis.allianz.com

# Partner ID assigned by Allianz
ALLIANZ_PARTNER_ID=DCAUTO

# SenangPay Payment Gateway
SENANGPAY_SECRET_KEY=your_senangpay_secret_key
SENANGPAY_MERCHANT_ID=your_merchant_id

# Allianz Callback x-api-key
CALLBACK_API_KEY=your-uuid-here

# Optional: Whitelist Allianz server IPs (comma-separated)
CALLBACK_ALLOWED_IPS=

# Public env vars (exposed to client-side)
NEXT_PUBLIC_SENANGPAY_MERCHANT_ID=your_merchant_id
