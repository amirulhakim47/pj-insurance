# ── App ──────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_AGENT_LEGAL_NAME=DC AUTO SERVICES (HALLU)
NEXT_PUBLIC_RAHMAH_PACKAGE_CODE=RAHMAH
# Set to true only in local/UAT to enable /results?demo=true
NEXT_PUBLIC_ALLOW_DEMO=false

# Signs short-lived tokens for policy status/PDF download (falls back to payment/callback secrets)
POLICY_ACCESS_SECRET=

# ── Allianz API (UAT) ───────────────────────────────────────
ALLIANZ_BASE_URL=https://asia-uat-malaysia.apis.allianz.com
ALLIANZ_CONSUMER_KEY=
ALLIANZ_CONSUMER_SECRET=
ALLIANZ_PARTNER_ID=DCAUTO

# ── SenangPay (UAT / sandbox) ───────────────────────────────
SENANGPAY_MERCHANT_ID=
SENANGPAY_SECRET_KEY=
NEXT_PUBLIC_SENANGPAY_MERCHANT_ID=

# ── Allianz Callback (Model B) ──────────────────────────────
# Shared secret — give the same value to Allianz for x-api-key header
CALLBACK_API_KEY=
# Comma-separated Allianz callback source IPs (required in production; empty allows IP check skip only in non-production)
CALLBACK_ALLOWED_IPS=

# ── Policy PDF storage (filesystem on VPS) ──────────────────
# Defaults to {app-root}/data/policies if unset
# POLICY_STORAGE_DIR=/var/data/pj-insrnce
