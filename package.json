{
  "name": "pj-insrnce",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:hostinger-zip": "bash scripts/build-hostinger-upload.sh",
    "build:hostinger": "next build",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "biome check",
    "format": "biome format --write",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "analyze": "ANALYZE=true npm run build",
    "lighthouse": "lighthouse http://localhost:3000 --output=html --output-path=./lighthouse-report.html",
    "deploy": "next build && touch out/.nojekyll && gh-pages -d out -t --dotfiles"
  },
  "dependencies": {
